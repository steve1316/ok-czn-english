msgstr "请选择1张获得的卡牌"

# From handle_equipment: title.name == "装备"
msgid "Equipment"
msgstr "装备"

# From handle_enter: _clean_match(box.name, "进入")
msgid "Enter"
msgstr "进入"

# From handle_leave: _clean_match(box.name, "离开")
msgid "Leave"
msgstr "离开"

# From handle_get_reward: _clean_match(box.name, "获得")
msgid "Obtain"
msgstr "获得"

# From _read_member_slots: _get_game_text(task, "重新搜索")
msgid "Search again"
msgstr "重新搜索"

