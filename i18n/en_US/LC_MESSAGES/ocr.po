msgstr "点击屏幕投掷骰子"

# From handle_negotiation: the test is `title.name in "失败"`, a substring-of check, so this has to be
# exactly "失败" and nothing longer. Failure is not a card, equipment or combatant name, so it cannot
# collide with a roster entry.
msgid "Failure"
msgstr "失败"

# From handle_card_reward: "卡牌奖励" in _get_region_text(task, (0.345, 0.012, 0.642, 0.141)), the title
# strip. Without it the page is never identified and handle_unknown_page clicks at random until it lands
# on a card. handle_get_card, which owns the caption below the title, is registered in Sortie only.
msgid "Card Reward"
msgstr "卡牌奖励"

# From handle_card_assign: "购买卡牌" in the title strip (0.326, 0.057, 0.671, 0.210).
# Without it the screen reads as a plain card assignment, so the handler picks a combatant, never presses
# Buy, and the run sits there clicking the same row once a second until it is stopped by hand.
msgid "Purchase Card"
msgstr "购买卡牌"

# From _read_member_slots: level_boxes keeps only boxes reading exactly "等级", and the combatant draft
# screen labels each card "LV". Without this no slot is found, so the handler never reaches its random
# pick and refreshes the same three candidates forever. The equipment screen writes "LEVEL" instead and
# is deliberately left unmapped, though src/en/templates.py accepts either form.
msgid "LV"
msgstr "等级"

# From _card_has_type_below and _equipment_slot: one English word serves both the card type label and the
# equipment stat row, and the two want different literals - "攻击" as a card type, "攻击力" as a stat.
# "攻击力" satisfies both, because every card-type test is a substring test and three characters still
# clears the four-character ceiling in _card_has_type_below.
# Collides with a card also named Attack; the label appears under every attack card, the card is one of 1,472.
msgid "Attack"
msgstr "攻击力"

# From _equipment_slot: _EQUIPMENT_TYPE_SLOTS keys off the stat named in the row beside the equipment.
msgid "Defense"
msgstr "防御力"

# From _equipment_slot: _EQUIPMENT_TYPE_SLOTS keys off the stat named in the row beside the equipment.
msgid "Health"
msgstr "生命值"

# From _card_has_type_below: matched against _CARD_TYPE_KEYWORDS.
msgid "Skill"
msgstr "技能"

# From _is_card_name: the one card type label the catalog never covered, so it reached the hand as a card
# name 24 times in a single Chaos recording.
msgid "Status Ailment"
msgstr "状态异常"

# From select_card: _get_game_text(task, "基础") drives the basic-card removal pass.
