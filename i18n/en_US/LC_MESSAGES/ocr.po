msgstr "基础攻击"

# From select_card: _get_game_text(task, "基础") drives the basic-card removal pass.
msgid "Basic Skill"
msgstr "基础技能"

# From _card_has_type_below: matched against _CARD_TYPE_KEYWORDS via the short form. Seven characters, so it
# fails the four-character test until it is rewritten. src/en/ocr_text.py retries this msgid after
# trimming the type icon, which covers the "4Upgrade" and "ZUpgrade" readings without an entry each.
msgid "Upgrade"
msgstr "强化"

# From _card_has_type_below: matched against _CARD_TYPE_KEYWORDS. The client's own card type is `card_curse`.
# Collides with a card also named Curse, and blocking curse cards is the shipped default, so the label wins.
msgid "Curse"
msgstr "咒术"

